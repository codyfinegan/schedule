{
    "name": "finy/schedule-backend",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.24",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.1",
        "relay/relay": "^3.0",
        "robmorgan/phinx": "^0.16.12",
        "symfony/console": "^8.1",
        "symfony/mailer": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Schedule\\": "src/"
        },
        "files": [
            "src/View/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Schedule\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.99"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
