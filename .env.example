# Variables Docker Compose substitutes into docker-compose*.yml (${VAR} syntax).
# This is separate from api/.env, which is injected into the api-php container
# itself. Copy to .env and fill in for prod; dev works fine with none of this set.

# Required for the prod stack (docker-compose.prod.yml) — the domain
# api-caddy requests its Let's Encrypt cert for. No default on purpose.
#API_DOMAIN=api.botc.example.com

# Dev-only overrides (docker-compose.override.yml). Both have working
# defaults out of the box — override RSVP_ADDRESS to match whatever local
# domain your own reverse proxy uses (see the proxy project's own docs).
#RSVP_ADDRESS=rsvp@botc.example.test
#RSVP_WEBHOOK_SECRET=dev-secret-change-me
